# Generated by Cargo
/target

# Workspace local settings & temporary assets
**/*.rs.bk
*.swp
*.tmp
.env
.env.*
!.env.example

# IDE & Editor files (keep shared RustRover run configurations)
.idea/*
!.idea/runConfigurations/
!.idea/codeStyles/
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
.vscode/

# OS files
.DS_Store
Thumbs.db

# Frontend Build & Node Artifacts
**/node_modules/
**/dist/
**/build/
package-lock.json


# Agent scratch + regenerable build artifacts (keep out of the repo)
.superpowers/
excalidraw.log
_reference/**/gen/
**/node_modules/
**/dist/
trivy_err*.log
scratchpad/
