+// Calendar exposes the daemon's real, persistent calendar event store (the
+// data `Sync` writes into via `DatabaseEngine::save_calendar_event`) over
+// authenticated gRPC, mirroring `Mail`'s read-path-plus-sync shape.
+//
+// SECURITY: this service MUST be mounted behind the SAME
+// `BearerAuthInterceptor` that guards every other service `nunciod`
+// exposes -- every gRPC service `nunciod` exposes MUST be authenticated,
+// with no exceptions carved out for "just one more" unauthenticated
+// service. See `nunciod::grpc::serve_on_listener`.
+service Calendar {
+  // Sync fetches events for one calendar collection from the account's real
+  // CalDAV backend (`nuncio_cal::CalendarBackend`) and persists them via the
+  // store, awaiting full completion before returning -- a successful
+  // response guarantees the synced events are already visible to
+  // `ListEvents`/`GetEvent`. Building a real per-account CalDAV client
+  // requires CalDAV credentials (`nuncio_cal::CalDavAccountConfig`) that
+  // account storage does not yet persist, so a real (non-test-injected)
+  // `Sync` call fails honestly -- `Status::unimplemented` -- rather than
+  // fabricating a synced count or silently returning zero events.
+  rpc Sync(CalendarSyncRequest) returns (CalendarSyncResponse);
+  // ListEvents returns persisted events for `account_id` whose window
+  // overlaps `[start_window, end_window]`, read straight from the store.
+  rpc ListEvents(ListEventsRequest) returns (ListEventsResponse);
+  // GetEvent returns a single persisted calendar event by ID.
+  rpc GetEvent(GetEventRequest) returns (CalendarEvent);
+}
+
+// Mirrors `nuncio_core::model::CalendarEvent` field-for-field.
+message CalendarEvent {
+  // Event identifier.
+  string id = 1;
+  // Account identifier owning the event.
+  string account_id = 2;
+  // Calendar collection identifier.
+  string calendar_id = 3;
+  // Event title or summary.
+  string summary = 4;
+  // Unix timestamp for event start.
+  int64 start_time = 5;
+  // Unix timestamp for event end.
+  int64 end_time = 6;
+  // Recurrence rule string (RFC 5545 RRULE format).
+  optional string rrule = 7;
+  // Location text.
+  optional string location = 8;
+}
+
+// CalendarSyncRequest. `calendar_id`/`start_window`/`end_window` mirror
+// `nuncio_cal::CalendarBackend::fetch_events`'s parameters exactly;
+// `account_id` names the account whose CalDAV credentials the real
+// (non-test-injected) path resolves.
+message CalendarSyncRequest {
+  // Account identifier owning the calendar collection.
+  string account_id = 1;
+  // Calendar collection identifier to fetch.
+  string calendar_id = 2;
+  // Window start (unix seconds, inclusive).
+  int64 start_window = 3;
+  // Window end (unix seconds, inclusive).
+  int64 end_window = 4;
+}
+
+// CalendarSyncResponse reports the REAL number of events synchronized --
+// never a fabricated count.
+message CalendarSyncResponse {
+  uint64 synced_count = 1;
+}
+
+// ListEventsRequest. Interval-overlap semantics, matching
+// `DatabaseEngine::list_calendar_events`: an event is included if its
+// `[start_time, end_time]` overlaps `[start_window, end_window]` at all, not
+// only if fully contained within it.
+message ListEventsRequest {
+  // Account identifier owning the events.
+  string account_id = 1;
+  // Window start (unix seconds, inclusive).
+  int64 start_window = 2;
+  // Window end (unix seconds, inclusive).
+  int64 end_window = 3;
+}
+
+// ListEventsResponse.
+message ListEventsResponse {
+  repeated CalendarEvent events = 1;
+}
+
+// GetEventRequest.
+message GetEventRequest {
+  // Unique event identifier.
+  string event_id = 1;
+}
