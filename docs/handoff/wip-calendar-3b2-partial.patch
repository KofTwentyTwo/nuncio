+++ b/crates/nunciod/src/calendar_sync.rs
@@ -0,0 +1,133 @@
+//! Real calendar synchronization routine.
+//!
+//! Mirrors `crate::sync`'s mail-sync shape: [`sync_with_backend`] takes `&dyn
+//! CalendarBackend` rather than a concrete engine, so it is exercised
+//! directly in tests with [`nuncio_cal::MockCalendarBackend`] -- no real
+//! network or OS keyring access ever happens inside it. There is
+//! deliberately no production entry point (analogous to `sync::run_account_sync`)
+//! yet: building a real `nuncio_cal::CalDavClient` needs a per-account
+//! `nuncio_cal::CalDavAccountConfig` (CalDAV URL, username, auth token) that
+//! account storage does not currently persist. Until that exists,
+//! `nunciod::grpc::CalendarGrpcService::sync` fails honestly rather than
+//! calling into this module with a fabricated backend.
+
+use nuncio_cal::CalendarBackend;
+use nuncio_core::model::CalendarEvent;
+use nuncio_store::db::DatabaseError;
+use thiserror::Error;
+
+/// Errors that can occur while synchronizing a single calendar collection.
+#[derive(Debug, Error)]
+pub enum CalendarSyncError {
+    /// The calendar backend (CalDAV, or an injected mock) reported an error.
+    #[error("calendar backend error: {0}")]
+    Backend(#[from] nuncio_cal::CalendarError),
+    /// A database persistence error occurred while saving synced events.
+    #[error("database error: {0}")]
+    Store(#[from] DatabaseError),
+}
+
+/// Fetch every event in `calendar_id` whose window overlaps `[start_window,
+/// end_window]` from `backend`, persisting each via
+/// [`nuncio_store::db::DatabaseEngine::save_calendar_event`]. Returns the
+/// number of events processed.
+///
+/// Contains no event-bus or credential logic -- pure fetch-and-persist, so
+/// it is the smallest unit tests can exercise directly with a
+/// [`nuncio_cal::MockCalendarBackend`].
+pub async fn sync_with_backend(
+    db: &nuncio_store::db::DatabaseEngine,
+    backend: &dyn CalendarBackend,
+    calendar_id: &str,
+    start_window: i64,
+    end_window: i64,
+) -> Result<usize, CalendarSyncError> {
+    let events: Vec<CalendarEvent> = backend
+        .fetch_events(calendar_id, start_window, end_window)
+        .await?;
+
+    let mut synced = 0usize;
+    for event in events {
+        db.save_calendar_event(&event).await?;
+        synced += 1;
+    }
+    Ok(synced)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use nuncio_cal::MockCalendarBackend;
+    use nuncio_store::db::DatabaseEngine;
+
+    fn mock_event(id: &str, account_id: &str, calendar_id: &str) -> CalendarEvent {
+        CalendarEvent {
+            id: id.to_string(),
+            account_id: account_id.to_string(),
+            calendar_id: calendar_id.to_string(),
+            summary: format!("Event {id}"),
+            start_time: 1_700_000_000,
+            end_time: 1_700_003_600,
+            rrule: None,
+            location: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn sync_with_backend_persists_mock_events() {
+        let (db, _dir) = DatabaseEngine::connect_ephemeral()
+            .await
+            .expect("ephemeral db");
+
+        let mock = MockCalendarBackend::new();
+        mock.add_event(mock_event("evt-1", "acct-1", "cal-work"));
+        mock.add_event(mock_event("evt-2", "acct-1", "cal-work"));
+
+        let synced = sync_with_backend(&db, &mock, "cal-work", 1_699_999_000, 1_700_004_000)
+            .await
+            .expect("sync succeeds");
+        assert_eq!(synced, 2);
+
+        let persisted = db
+            .list_calendar_events("acct-1", 1_699_999_000, 1_700_004_000)
+            .await
+            .expect("list persisted events");
+        assert_eq!(persisted.len(), 2);
+    }
+
+    #[tokio::test]
+    async fn sync_with_backend_propagates_backend_failure_without_persisting() {
+        let (db, _dir) = DatabaseEngine::connect_ephemeral()
+            .await
+            .expect("ephemeral db");
+
+        let mock = MockCalendarBackend::new();
+        mock.set_should_fail(true);
+
+        let err = sync_with_backend(&db, &mock, "cal-work", 0, 10)
+            .await
+            .expect_err("sync fails");
+        assert!(matches!(err, CalendarSyncError::Backend(_)));
+
+        let persisted = db
+            .list_calendar_events("acct-1", 0, i64::MAX)
+            .await
+            .expect("list persisted events");
+        assert!(persisted.is_empty());
+    }
+
+    #[tokio::test]
+    async fn sync_with_backend_returns_zero_for_empty_window() {
+        let (db, _dir) = DatabaseEngine::connect_ephemeral()
+            .await
+            .expect("ephemeral db");
+
+        let mock = MockCalendarBackend::new();
+        mock.add_event(mock_event("evt-out-of-window", "acct-1", "cal-work"));
+
+        let synced = sync_with_backend(&db, &mock, "cal-work", 0, 10)
+            .await
+            .expect("sync succeeds");
+        assert_eq!(synced, 0);
+    }
+}
